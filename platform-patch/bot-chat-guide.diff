+.smd td:first-child { min-width: 6rem; font-weight: 600; }
+.smd blockquote {
+    margin: 0.75rem 0;
+    padding: 0.5rem 0.9rem;
+    border-inline-start: 3px solid #2ec4a6;
+    background: #f5fbf9;
+    border-radius: 6px;
+}
+.smd blockquote > :last-child { margin-bottom: 0; }
+.smd h1, .smd h2, .smd h3, .smd h4 { margin: 1rem 0 0.5rem; line-height: 1.35; }
+.smd ul, .smd ol { padding-inline-start: 1.4rem; margin: 0.4rem 0 0.8rem; }
+.smd li + li { margin-top: 0.25rem; }
+.smd p { margin: 0 0 0.75rem; }
+.smd hr { border: 0; border-top: 1px solid #e5e8ef; margin: 1rem 0; }
+.smd code { background: #f3f5fa; padding: 0.1em 0.35em; border-radius: 4px; }
+</style>
